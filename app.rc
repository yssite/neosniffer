#include <windows.h>

#define IDI_APPICON 1

IDI_APPICON ICON "assets/app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Disk space analyzer\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "SpaceSnifferNeo\0"
            VALUE "OriginalFilename", "SpaceSniffer.exe\0"
            VALUE "ProductName",      "SpaceSniffer Neo\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
            VALUE "LegalCopyright",   "SpaceSniffer Neo - reimplementation of SpaceSniffer 1.3.0.2\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
